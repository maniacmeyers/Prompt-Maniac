# Database Configuration
# Get these from your Supabase project dashboard
# Use the IPv4-compatible Shared Pooler endpoint

# Transaction Pooler (for application queries) - Port 6543
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session Pooler (for migrations) - Port 5432
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-api-key-here"
